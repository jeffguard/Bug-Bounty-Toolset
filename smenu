#!/bin/bash

trap "" SIGTSTP
trap '' SIGINT

HEIGHT=19
CHOICE_HEIGHT=10
WIDTH=70
BACKTITLE="Kali Linux"
TITLE="[ Bug Bounty Toolkit ]"

########################
# MAIN MENU
########################
main_menu() {
    while true; do
        CHOICE=$(dialog --clear --no-cancel \
            --backtitle "$BACKTITLE" \
            --title "$TITLE" \
            --menu "Main Menu:" \
            $HEIGHT $WIDTH $CHOICE_HEIGHT \
            Reconnaissance              "Information gathering & OSINT" \
            Subdomain_Enumeration       "Discover subdomains" \
            Web_Application_Testing     "Test web applications" \
            API_Security_Testing        "Test APIs" \
            Network_Security_Testing    "Network assessments" \
            Vulnerability_Scanners      "Automated scanners" \
            Fuzzing_Tools               "Fuzzing utilities" \
            Exploitation_Tools          "Exploit frameworks" \
            Reporting_Automation        "Reporting & automation" \
            Admin                       "System administration" \
            Exit                        "Exit to shell" \
            2>&1 > /dev/tty)

        case $CHOICE in
            Reconnaissance) recon_menu ;;
            Subdomain_Enumeration) enum_menu ;;
            Web_Application_Testing) web_menu ;;                                                              
            API_Security_Testing) api_menu ;;                                                                 
            Network_Security_Testing) net_menu ;;                                                             
            Vulnerability_Scanners) vuln_menu ;;                                                              
            Fuzzing_Tools) fuzz_menu ;;                                                                       
            Exploitation_Tools) exploit_menu ;;                                                               
            Reporting_Automation) report_menu ;;                                                              
            Admin) admin_menu ;;                                                                              
            Exit) clear; exit ;;                                                                              
        esac                                                                                                  
    done                                                                                                      
}                                                                                                             
                                                                                                              
########################                                                                                      
# RECON                                                                                                       
########################                                                                                      
recon_menu() {                                                                                                
    while true; do                                                                                            
        CHOICE=$(dialog --clear \                                                                             
            --backtitle "$BACKTITLE" \
            --title "[ Reconnaissance ]" \
            --menu "Select Tool:" \
            $HEIGHT $WIDTH $CHOICE_HEIGHT \
            Amass        "DNS & asset discovery" \
            Assetfinder "Find related domains" \
            Hakrawler   "Web crawler" \
            Back        "Return to main menu" \
            2>&1 > /dev/tty)

        case $CHOICE in
            Amass) amass ;;
            Assetfinder) assetfinder ;;
            Hakrawler) hakrawler ;;
            Back) return ;;
        esac
    done
}

