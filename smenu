            Back "Return to main menu" \
            2>&1 > /dev/tty)

        case $CHOICE in
            Menu) sudo vi /usr/local/bin/bug ;;
            Lock) vlock ;;
            Logout) pkill -KILL -u "$USER" ;;
            Reboot) sudo reboot ;;
            Back) return ;;
        esac
    done
}

